{
  "meta": {
    "name": "Rova NRS CIT minimal question flow",
    "version": "1.0",
    "principle": "Show only the next question a given business needs. Never render a question whose 'show_if' condition is false. Chip-select fields collapse a whole NRS category list into one tap-based screen; only tapped chips become amount inputs.",
    "answer_store": "All answers write into a flat key-value store `answers{}`. show_if conditions and derive formulas read from this store."
  },

  "stages": [

    {
      "id": "profile",
      "title": "Business profile",
      "always_show": true,
      "questions": [
        {
          "id": "year_of_assessment",
          "type": "number",
          "prompt": "Year of assessment",
          "default": "2026",
          "nrs_field": "USER_INPUT!D7",
          "required": true
        },
        {
          "id": "entity_type",
          "type": "single_select",
          "prompt": "What type of entity is this?",
          "options": ["Company", "NGO / Non-profit", "Trust", "Other"],
          "nrs_field": "meta:entity_type",
          "required": true,
          "effects": {
            "NGO / Non-profit": "reframe_stage:other_income; possible_exemption_flag=true"
          }
        },
        {
          "id": "sectors",
          "type": "multi_select_searchable",
          "prompt": "Which sector(s) does your business earn revenue from?",
          "options": [
            "Agriculture", "Manufacturing", "Mining & Quarry", "Construction",
            "Wholesale & Retail Trade", "Transportation & Storage", "Accommodation & Food Services",
            "Information & Communication", "Financial & Insurance", "Real Estate Activities",
            "Professional, Scientific & Technical", "Administrative & Support Services",
            "Education", "Human Health & Social Work", "Arts, Entertainment & Recreation",
            "Oil & Gas Services", "Power & Energy", "E-commerce & Digital Economy", "Other Services"
          ],
          "nrs_field": "INCOME_STATEMENT!C7:C27",
          "required": true,
          "min_select": 1,
          "effects": {
            "any_of:[Manufacturing, Mining & Quarry, Construction]": "unlock_stage:cost_of_sales.sector_specific_direct_costs"
          }
        },
        {
          "id": "business_model",
          "type": "single_select",
          "prompt": "Do you sell physical products, provide services only, or both?",
          "options": ["Goods only", "Services only", "Both"],
          "nrs_field": "meta:business_model",
          "required": true,
          "effects": {
            "Services only": "skip_stage:cost_of_sales.inventory_and_purchases; show_stage:cost_of_sales.service_cost_simplified",
            "Goods only|Both": "show_stage:cost_of_sales.full"
          }
        }
      ]
    },

    {
      "id": "revenue",
      "title": "Revenue",
      "always_show": true,
      "questions": [
        {
          "id": "revenue_per_sector",
          "type": "number_repeat_per_selection",
          "repeat_source": "answers.sectors",
          "prompt_template": "What was your total revenue from {sector} this year?",
          "nrs_field_template": "INCOME_STATEMENT!E{row_for_sector}",
          "required": true
        }
      ],
      "calculated": [
        { "id": "total_revenue", "formula": "sum(revenue_per_sector)", "nrs_field": "INCOME_STATEMENT!E33,E107" }
      ]
    },

    {
      "id": "cost_of_sales",
      "title": "Cost of sales / direct cost",
      "show_if": "answers.business_model != 'Services only'",
      "questions": [
        {
          "id": "opening_inventory_total",
          "type": "number",
          "prompt": "What was your opening inventory value?",
          "nrs_field": "INCOME_STATEMENT!D69",
          "required": true,
          "optional_breakdown": {
            "toggle_label": "Break down by raw materials / WIP / finished goods",
            "fields": ["raw_materials", "work_in_progress", "finished_goods"],
            "nrs_fields": ["D66", "D67", "D68"]
          }
        },
        {
          "id": "purchases_local",
          "type": "number",
          "prompt": "Local purchases",
          "nrs_field": "INCOME_STATEMENT!D71",
          "required": true
        },
        {
          "id": "purchases_import",
          "type": "number",
          "prompt": "Import purchases",
          "nrs_field": "INCOME_STATEMENT!D72",
          "required": false
        },
        {
          "id": "purchase_returns",
          "type": "number",
          "prompt": "Purchase returns (if any)",
          "nrs_field": "INCOME_STATEMENT!D73",
          "required": false
        },
        {
          "id": "direct_costs_chips",
          "type": "chip_select_then_amount",
          "prompt": "Which direct costs applied to your business?",
          "base_options": ["Direct wages", "Direct expenses", "Carriage inwards", "Depreciation", "Other direct costs"],
          "conditional_options": {
            "sectors_includes:Mining & Quarry": ["Mining cost"],
            "sectors_includes:Construction": ["Direct construction cost"]
          },
          "nrs_field_map": {
            "Direct wages": "D76", "Direct expenses": "D77", "Carriage inwards": "D78",
            "Depreciation": "D79", "Mining cost": "D80", "Direct construction cost": "D81",
            "Other direct costs": "D84"
          },
          "flags_set": { "Depreciation": "flag.direct_depreciation_amount" }
        },
        {
          "id": "factory_overheads_chips",
          "type": "chip_select_then_amount",
          "show_if": "answers.business_model != 'Services only'",
          "prompt": "Which factory / production overheads applied?",
          "options": ["Factory rent", "Factory rates", "Fuel and power", "Indirect wages", "Other factory overheads"],
          "nrs_field_map": { "Factory rent": "D87", "Factory rates": "D88", "Fuel and power": "D89", "Indirect wages": "D90", "Other factory overheads": "D91" }
        },
        {
          "id": "closing_inventory_total",
          "type": "number",
          "prompt": "What was your closing inventory value?",
          "nrs_field": "INCOME_STATEMENT!D97",
          "required": true,
          "optional_breakdown": {
            "toggle_label": "Break down by raw materials / WIP / finished goods",
            "fields": ["raw_materials", "work_in_progress", "finished_goods"],
            "nrs_fields": ["D94", "D95", "D96"]
          },
          "flags_set": { "self": "flag.closing_inventory_value" }
        }
      ],
      "calculated": [
        { "id": "cost_of_sales_total", "formula": "opening_inventory_total + (purchases_local + purchases_import - purchase_returns) + sum(direct_costs_chips) + sum(factory_overheads_chips) - closing_inventory_total", "nrs_field": "INCOME_STATEMENT!E63,E108" }
      ]
    },

    {
      "id": "other_income",
      "title": "Other income",
      "questions": [
        {
          "id": "has_other_income",
          "type": "boolean",
          "prompt": "Did you earn any income besides your main business revenue this year?",
          "required": true
        },
        {
          "id": "other_income_chips",
          "type": "chip_select_then_amount",
          "show_if": "answers.has_other_income == true",
          "prompt": "Which of these applied to you?",
          "options": ["Commission income", "Interest income", "Lease income (finance)", "Rental income", "Dividend income",
                      "Profit from disposal of investment in subsidiary", "Decrease in provision", "Gain on sale of asset",
                      "Non-taxable revenue", "Realized FX gain", "Unrealized FX gain", "Bad debt recovered", "Other investment income", "Others"],
          "nrs_field_map": {
            "Commission income": "OTHER_INCOME!C4", "Interest income": "C5", "Lease income (finance)": "C6",
            "Rental income": "C7", "Dividend income": "C8", "Profit from disposal of investment in subsidiary": "C9",
            "Decrease in provision": "C10", "Gain on sale of asset": "C11", "Non-taxable revenue": "C12",
            "Realized FX gain": "C13", "Unrealized FX gain": "C14", "Bad debt recovered": "C15",
            "Other investment income": "C16", "Others": "C17"
          },
          "flags_set": {
            "Dividend income": "flag.dividend_income_amount",
            "Gain on sale of asset": "flag.gain_on_disposal_amount",
            "Non-taxable revenue": "flag.has_nontaxable_revenue",
            "Unrealized FX gain": "flag.unrealized_fx_gain_amount"
          }
        }
      ],
      "calculated": [
        { "id": "total_other_income", "formula": "sum(other_income_chips)", "nrs_field": "OTHER_INCOME!E3 -> INCOME_STATEMENT!E110" }
      ]
    },

    {
      "id": "admin_expenses",
      "title": "Administrative expenses",
      "always_show": true,
      "questions": [
        {
          "id": "admin_expense_chips",
          "type": "chip_select_then_amount",
          "prompt": "Which administrative expenses applied to your business this year?",
          "ui": "grouped_searchable_chips",
          "groups": {
            "Staff costs": ["Salary and Wages", "Employee Benefit Expenses", "Directors Emoluments", "Directors expenses", "Staff Allowances", "Staff Loan written off", "Staff Gratuity", "Pension and Gratuity", "Other staff & related Cost"],
            "Occupancy & utilities": ["Rent & Rates", "Rates", "Electricity & Power", "Fuel expenses", "Generator expenses", "AGO-Diesel", "PMS", "Internet Cost", "Telephone", "Utilities", "Cleaning & Janitory Services"],
            "Professional & compliance": ["Audit fees", "other professional fees", "Government and regulatory costs", "Licences & leases charges", "Other statutory charges & levies", "Permits", "Fines", "penalties", "AMCON charges"],
            "Marketing & travel": ["Advertisement & Promotion", "Public Relation", "Corporate promotion", "Sponsorship", "Trade fairs & exhibitions", "Travel Expenses", "Rooms/ Accomodation cost"],
            "Finance & other": ["depreciation", "Amortisation of intangible assets", "Bank charges", "Interest Expense", "Bad Debt written off", "Donations", "Entertainment expenses", "Loss on sale of property, plants and equipments", "Realized foreign exchange loss", "Repairs and Maintenance", "Security expenses", "Insurance", "Others"]
          },
          "note": "Full 67-item list available via search; groups above are the default browse view.",
          "flags_set": {
            "depreciation": "flag.admin_depreciation_amount",
            "Donations": "flag.donations_amount",
            "Entertainment expenses": "flag.entertainment_amount",
            "Fines": "flag.fines_amount",
            "penalties": "flag.penalties_amount",
            "Loss on sale of property, plants and equipments": "flag.loss_on_disposal_amount",
            "Realized foreign exchange loss": "flag.fx_loss_amount",
            "Pension and Gratuity": "flag.has_pension_expense"
          }
        }
      ],
      "calculated": [
        { "id": "total_admin_expenses", "formula": "sum(admin_expense_chips)", "nrs_field": "ADMINISTRATIVE_EXPENSES!D3 -> INCOME_STATEMENT!E112" }
      ]
    },

    {
      "id": "tax_and_comprehensive_income",
      "title": "Tax, comprehensive income, retained earnings",
      "always_show": true,
      "questions": [
        {
          "id": "tax_paid_or_payable",
          "type": "number",
          "prompt": "Tax paid or payable for the period (leave blank to let us compute it)",
          "required": false,
          "nrs_field": "INCOME_STATEMENT!D116"
        },
        {
          "id": "has_other_comprehensive_income",
          "type": "boolean",
          "prompt": "Any other comprehensive income — revaluation, FX translation, hedging, pension plan adjustments?",
          "required": true
        },
        {
          "id": "oci_chips",
          "type": "chip_select_then_amount",
          "show_if": "answers.has_other_comprehensive_income == true",
          "options": ["Revaluation Gain/Loss", "Unrealized foreign exchange gain", "Currency Translation Adjustments", "Cash Flow Hedge", "Gain Or Loss On Derivative Contracts", "Pension Plans Adjustments", "Others"],
          "nrs_field_map": { "Revaluation Gain/Loss": "E119", "Unrealized foreign exchange gain": "E120", "Currency Translation Adjustments": "E121", "Cash Flow Hedge": "E122", "Gain Or Loss On Derivative Contracts": "E123", "Pension Plans Adjustments": "E124", "Others": "E125" }
        },
        {
          "id": "retained_earnings_brought_forward",
          "type": "number",
          "prompt": "Retained earnings brought forward from last year's accounts",
          "required": true,
          "nrs_field": "INCOME_STATEMENT!E127"
        }
      ],
      "calculated": [
        { "id": "operating_profit_before_tax", "formula": "total_revenue - cost_of_sales_total + total_other_income - total_admin_expenses", "nrs_field": "INCOME_STATEMENT!E113" },
        { "id": "profit_for_year", "formula": "operating_profit_before_tax - tax_paid_or_payable + sum(oci_chips)", "nrs_field": "INCOME_STATEMENT!E126" },
        { "id": "retained_earnings_carried_forward", "formula": "profit_for_year + retained_earnings_brought_forward", "nrs_field": "INCOME_STATEMENT!E128" }
      ]
    },

    {
      "id": "profit_adjustment",
      "title": "Add-backs & deductions",
      "always_show": true,
      "derived": [
        { "id": "addback_depreciation", "formula": "flag.direct_depreciation_amount + flag.admin_depreciation_amount", "nrs_field": "PROFIT_ADJUSTMENT!E13", "ui": "confirm_card" },
        { "id": "addback_loss_on_disposal", "formula": "flag.loss_on_disposal_amount", "show_if": "flag.loss_on_disposal_amount > 0", "nrs_field": "E17", "ui": "confirm_card" },
        { "id": "addback_penalty_or_fine", "formula": "flag.fines_amount + flag.penalties_amount", "show_if": "(flag.fines_amount + flag.penalties_amount) > 0", "nrs_field": "E29", "ui": "confirm_card" },
        { "id": "deduction_frank_investment_income", "formula": "flag.dividend_income_amount", "show_if": "flag.dividend_income_amount > 0", "nrs_field": "E38", "ui": "confirm_card" },
        { "id": "deduction_profit_from_disposal", "formula": "flag.gain_on_disposal_amount", "show_if": "flag.gain_on_disposal_amount > 0", "nrs_field": "E37", "ui": "confirm_card" },
        { "id": "deduction_unrealised_gains", "formula": "flag.unrealized_fx_gain_amount", "show_if": "flag.unrealized_fx_gain_amount > 0", "nrs_field": "E39", "ui": "confirm_card" }
      ],
      "questions": [
        {
          "id": "fx_loss_unrealised_confirm",
          "type": "boolean",
          "show_if": "flag.fx_loss_amount > 0",
          "prompt": "Was any of your foreign exchange loss unrealised (not yet settled in cash)?",
          "nrs_field": "E16"
        },
        {
          "id": "exempt_income_expenses",
          "type": "number",
          "show_if": "flag.has_nontaxable_revenue == true",
          "prompt": "What expenses were directly related to your non-taxable income?",
          "required": true,
          "nrs_field": "E14"
        },
        {
          "id": "donations_disallowed",
          "type": "number",
          "show_if": "flag.donations_amount > 0",
          "prompt": "Were any donations made to a body NOT on the NRS-approved list? If so, how much?",
          "required": false,
          "nrs_field": "E15"
        },
        {
          "id": "entertainment_disallowed",
          "type": "number",
          "show_if": "flag.entertainment_amount > 0",
          "prompt": "How much of your entertainment expense was unrelated to your business?",
          "required": false,
          "nrs_field": "E18"
        },
        {
          "id": "capital_expense_miscoded",
          "type": "boolean_then_amount",
          "prompt": "Did you record any asset purchases as expenses this year?",
          "default": false,
          "nrs_field": "E20"
        },
        {
          "id": "pension_unapproved",
          "type": "boolean",
          "show_if": "flag.has_pension_expense == true",
          "prompt": "Is your pension scheme approved under the Pension Reform Act (e.g. PenCom-registered)?",
          "nrs_field": "E24",
          "note": "If 'No', the pension expense amount becomes an add-back."
        },
        {
          "id": "catch_all_addback",
          "type": "number",
          "prompt": "Anything else your accountant flagged as an add-back? (optional)",
          "required": false,
          "nrs_field": "E32"
        }
      ]
    },

    {
      "id": "financial_position",
      "title": "Statement of financial position",
      "always_show": true,
      "derived": [
        { "id": "inventories", "formula": "flag.closing_inventory_value", "nrs_field": "STATEMENT_OF_FINANCIAL_POSITION!E46" },
        { "id": "retained_earnings_equity", "formula": "retained_earnings_carried_forward", "nrs_field": "C114" },
        { "id": "current_tax_liabilities_prefill", "formula": "tax_paid_or_payable", "note": "prefilled but editable", "nrs_field": "E74" }
      ],
      "questions": [
        {
          "id": "non_current_assets_chips",
          "type": "chip_select_then_amount_nested",
          "prompt": "Which non-current assets does your business hold?",
          "top_level": ["Properties, Plant & Equipment", "Investments", "Intangible assets", "Other non-current assets"],
          "nested_on": {
            "Investments": ["Investment in securities", "Investment in stock and bonds", "Investment in properties", "Investment in associates/JV", "Investment in subsidiaries", "Investment in digital assets", "Others"],
            "Intangible assets": ["Goodwill", "Patent", "Trademarks", "Brands", "Right of use", "Copyrights", "Others"],
            "Other non-current assets": ["Lease-hold land", "Lease-hold building", "Deferred tax asset", "Other financial assets", "Others"]
          },
          "nrs_field_map_top": { "Properties, Plant & Equipment": "E8", "Investments": "E9", "Intangible assets": "E20", "Other non-current assets": "E30" }
        },
        {
          "id": "current_assets_chips",
          "type": "chip_select_then_amount",
          "prompt": "Which current assets (besides inventory) does your business hold?",
          "options": ["Other receivables", "Trade receivables", "Cash and cash equivalents", "Other current assets"],
          "nrs_field_map": { "Other receivables": "E47", "Trade receivables": "E48", "Cash and cash equivalents": "E63", "Other current assets": "E49" }
        },
        {
          "id": "current_liabilities_chips",
          "type": "chip_select_then_amount",
          "prompt": "Which current liabilities does your business have?",
          "options": ["Trade payables", "Other current liabilities"],
          "nrs_field_map": { "Trade payables": "E73", "Other current liabilities": "E75" },
          "note": "Current tax liabilities is pre-filled from tax_paid_or_payable, not re-asked."
        },
        {
          "id": "non_current_liabilities_chips",
          "type": "chip_select_then_amount",
          "prompt": "Which non-current (long-term) liabilities does your business have?",
          "options": ["Long-term debt/borrowings", "Pension and employee benefit obligation", "Deferred tax liabilities", "Lease liabilities", "Others"],
          "nrs_field_map_group": "E94"
        },
        {
          "id": "equity_chips",
          "type": "chip_select_then_amount",
          "prompt": "Which equity components apply? (Retained earnings already carried over)",
          "options": ["Issued share capital", "Share premium", "Revaluation reserve", "Statutory reserve", "Other reserves"],
          "nrs_field_map_group": "C112:C125"
        }
      ],
      "calculated": [
        { "id": "total_non_current_assets", "formula": "sum(non_current_assets_chips)", "nrs_field": "E43" },
        { "id": "total_current_assets", "formula": "inventories + sum(current_assets_chips)", "nrs_field": "E68" },
        { "id": "total_assets", "formula": "total_non_current_assets + total_current_assets", "nrs_field": "E69" },
        { "id": "total_current_liabilities", "formula": "sum(current_liabilities_chips) + current_tax_liabilities_prefill", "nrs_field": "E93" },
        { "id": "non_current_liabilities_total", "formula": "sum(non_current_liabilities_chips)", "nrs_field": "E94" },
        { "id": "total_equity", "formula": "sum(equity_chips) + retained_earnings_equity", "nrs_field": "E126" },
        { "id": "balance_check", "formula": "total_assets == (total_current_liabilities + non_current_liabilities_total + total_equity)", "ui": "live_inline_warning_if_false" }
      ]
    },

    {
      "id": "review_and_submit",
      "title": "Review & submit",
      "always_show": true,
      "ui": "full_computed_statement_preview",
      "questions": [
        { "id": "confirm_and_submit", "type": "confirm_action", "prompt": "Everything looks correct — submit to NRS?" }
      ]
    }
  ]
}
